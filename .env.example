# ============================================================
# Bifrost Route · Layer 1 (Data Layer) — environment template
# Copy to .env and adjust. NEVER commit the real .env.
# ============================================================

# ── MySQL (policies, budgets, model registry) ──────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=bifrost_dev_password
MYSQL_DATABASE=bifrost_route

# ── Redis (semantic cache) ─────────────────────────────────
REDIS_HOST=127.0.0.1
# 6380 by default here because 6379 is commonly taken on Windows dev machines
REDIS_PORT=6380
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=3600          # plan: TTL 1 hour
REDIS_MAXMEMORY_BYTES=16777216        # 16 MB demo budget → forces LRU eviction
REDIS_MAXMEMORY_POLICY=allkeys-lru    # plan: LRU eviction policy

# ── DynamoDB (query traces) ────────────────────────────────
# Local: DynamoDB Local container. To point at real AWS DynamoDB,
# leave DYNAMODB_ENDPOINT empty and set real credentials.
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_AWS_ACCESS_KEY_ID=dummy
DYNAMODB_AWS_SECRET_ACCESS_KEY=dummy
DYNAMODB_TABLE=query_traces

# ── Warehouse (Redshift stand-in: DuckDB locally) ──────────
WAREHOUSE_ENGINE=duckdb               # duckdb | redshift (later, via AWS)
WAREHOUSE_PATH=./data/warehouse.duckdb
WAREHOUSE_TRACES_PARQUET=./data/traces.parquet

# ── Layer 2 (Retrieval) ─────────────────────────────────────────────────
# Neo4j knowledge graph (community container)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bifrost_neo4j_pw
# Qdrant vector store (Pinecone stand-in)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=bifrost_docs
# fastembed ONNX models (downloaded once, then offline; empty → TF-IDF/score fallback)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Layer 4 (Routing) ───────────────────────────────────────────────────
# Real provider LLM calls (set to leave dry-run mode; both optional —
# without them the router uses a deterministic local mock and every gate
# still passes). Keys: https://console.groq.com · https://aistudio.google.com
GROQ_API_KEY=
GEMINI_API_KEY=
# 1 = deterministic dry-run LLM (default) | 0 = call real providers when
# keys are present
BIFROST_DRY_RUN=1
# classifier backend: tfidf-lr (no training needed, default fallback) ·
# distilbert-onnx (auto-selected when trained artifacts are fresh) ·
# distilbert-torch — leave empty for auto-select
BIFROST_CLASSIFIER_MODE=
# FastAPI port (uvicorn)
BIFROST_API_PORT=8077

# ── Layer 5 (RAGAS judge) ───────────────────────────────────────────────
# Real RAGAS faithfulness/context_precision use an LLM judge. Same keys as
# Layer 4 (Groq or Gemini, either suffices) — no key = deterministic offline
# proxy judge (bge cosine + L2 family ground truth), gates still run.
# Optional judge-model overrides (defaults are tier-appropriate):
BIFROST_JUDGE_GROQ_MODEL=llama-3.3-70b-versatile
BIFROST_JUDGE_GEMINI_MODEL=gemini-2.5-pro