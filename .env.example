# ============================================================
# Bifrost Route · Layer 1 (Data Layer) — environment template
# Copy to .env and adjust. NEVER commit the real .env.
# ============================================================

# ── MySQL (policies, budgets, model registry) ──────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=bifrost_dev_password
MYSQL_DATABASE=bifrost_route

# ── Redis (semantic cache) ─────────────────────────────────
REDIS_HOST=127.0.0.1
# 6380 by default here because 6379 is commonly taken on Windows dev machines
REDIS_PORT=6380
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=3600          # plan: TTL 1 hour
REDIS_MAXMEMORY_BYTES=16777216        # 16 MB demo budget → forces LRU eviction
REDIS_MAXMEMORY_POLICY=allkeys-lru    # plan: LRU eviction policy

# ── DynamoDB (query traces) ────────────────────────────────
# Local: DynamoDB Local container. To point at real AWS DynamoDB,
# leave DYNAMODB_ENDPOINT empty and set real credentials.
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_AWS_ACCESS_KEY_ID=dummy
DYNAMODB_AWS_SECRET_ACCESS_KEY=dummy
DYNAMODB_TABLE=query_traces

# ── Warehouse (Redshift stand-in: DuckDB locally) ──────────
WAREHOUSE_ENGINE=duckdb               # duckdb | redshift (later, via AWS)
WAREHOUSE_PATH=./data/warehouse.duckdb
WAREHOUSE_TRACES_PARQUET=./data/traces.parquet